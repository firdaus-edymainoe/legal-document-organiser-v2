    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
